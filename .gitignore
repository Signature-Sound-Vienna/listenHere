# Exhibit data, GENERATED by tools/prep_exhibit_data.py from ExhibitAnnots/ and the
# gitignored wav corpus. Regenerable, and too big to carry: the payload is ~4.8 MB,
# the pinned MEI ~4.2 MB, and the transcoded audio ~72 MB.
/app/static/exhibit/data/*.json
/app/static/exhibit/data/*.mei
# No trailing slash: a worktree may satisfy this with a SYMLINK to the main
# checkout’s transcoded set, and dir-only patterns do not match symlinks.
/app/static/exhibit/audio
# ...but the *overrides.json files are AUTHORED DATA, not build products, and MUST
# be committed: `overrides.json` holds the hand-placed region times that no
# re-alignment may recompute (plan §5.2d), and `metadata-overrides.json` holds the
# conductor/year facts the RDF cannot answer, each with its source cited. Both prep
# scripts apply them LAST and never rewrite them. The glob is deliberate, so a
# future third override file is committed by default rather than silently ignored.
!/app/static/exhibit/data/*overrides.json

# Cached MusicBrainz JSON-LD, fetched by tools/prep_exhibit_metadata.py. Purely a
# dev convenience so a re-run is offline and the API is asked once per entity;
# --refresh-mb refetches. Nothing here is authored.
/tools/.cache/

# Physical-artefact reference scans (CD booklet, jewel case and disc photographs)
# used to date the Philharmonie Lugansk recording. Kept LOCAL: ~16 MB, and a scan of
# someone else's commercial artwork. The reasoning it supports is written up in
# app/static/exhibit/data/metadata-overrides.json and in the MusicBrainz edit notes.
/Lugansk/

# Phase-0 de-risking spikes (throwaway probes, local-only)
/app/static/spikes/

