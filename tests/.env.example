# Listen Here! — Playwright E2E Test Environment
# Copy this file to tests/.env and fill in the values.
# tests/.env is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Base URL of the Flask dev server used during testing.
# Default assumes the server is started separately before running tests.
APP_BASE_URL=http://localhost:5001

# ---------------------------------------------------------------------------
# Remote test fixtures
# ---------------------------------------------------------------------------

# Public URL of the alignment JSON used for remote-load tests (scenario 1.1).
# Must be accessible without authentication.
REMOTE_ALIGNMENT_URL=https://example.com/test/alignment.json

# Public base URL where the corresponding audio files are hosted (optional).
# Used for remote audio loading tests.
REMOTE_AUDIO_BASE_URL=https://example.com/test/audio/

# ---------------------------------------------------------------------------
# Solid / Linked Data annotation tests (Section 18)
# ---------------------------------------------------------------------------

# Base URL of the dedicated test Solid pod server.
SOLID_POD_URL=https://your-test-pod.example/

# WebID of the test user account on the pod.
SOLID_WEBID=https://your-test-pod.example/profile/card#me

# Credentials for the test user (used to obtain an access token via Client
# Credentials or Resource Owner Password flow — see Solid CSS documentation).
SOLID_CLIENT_ID=test-client-id
SOLID_CLIENT_SECRET=test-client-secret

# Container on the pod where test annotations will be written and cleaned up.
# Must exist and be writable by the test user. Will be cleared before each
# annotation test run.
SOLID_ANNOTATION_CONTAINER=https://your-test-pod.example/listenhere-test/oa/

# Container for MAO selections.
SOLID_SELECTION_CONTAINER=https://your-test-pod.example/listenhere-test/mao/selection/

# URI prefix to use when constructing audio Linked Data URIs in annotation tests.
SOLID_AUDIO_URI_PREFIX=https://your-test-pod.example/audio/

# ---------------------------------------------------------------------------
# Optional: local audio server (scenario 1.7 — ?useLocal)
# ---------------------------------------------------------------------------

# Base URL of a local HTTP server serving the test audio files.
# Only needed if running the ?useLocal tests.
# LOCAL_AUDIO_SERVER_URL=http://localhost:8080
